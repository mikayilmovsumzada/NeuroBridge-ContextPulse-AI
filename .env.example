GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Provayderlərin sınanma sırası (yalnız açarı olanlar istifadə olunur):
AI_PROVIDERS=gemini,claude
DB_PATH=./contextpulse.db
# IDE genişləndirməsi və simulator.py bu açarla hadisə göndərir. Uzun təsadüfi dəyər yazın:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_KEY=
# simulator.py-ın server ünvanı (boş: localhost:8000, sonra 8001 axtarılır)
# SIMULATOR_URL=http://localhost:8001
# Demo hesablar (verilməsə README-dəki dəyərlər işləyir). Paylaşılan serverdə mütləq dəyişin:
# DEMO_EMPLOYEE_EMAIL=
# DEMO_EMPLOYEE_PASSWORD=
# DEMO_MANAGER_EMAIL=
# DEMO_MANAGER_PASSWORD=

# ---------- İctimai demo (məs. https://contextpulse.nexusweb.az) ----------
# 1: elan, tədbir qeydi və məsul yalnız hazır şablonlardan; demo məlumatı müntəzəm sıfırlanır
DEMO_MODE=0
# Avtomatik sıfırlama intervalı, dəqiqə (yalnız DEMO_MODE=1 olanda; 0 söndürür)
DEMO_RESET_MINUTES=30

# ---------- Sorğu limiti (müştəri IP-si üzrə, format: sorğu/saniyə) ----------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_REMINDER=20/60
RATE_LIMIT_SURVEY=20/60
RATE_LIMIT_MESSAGES=10/60
RATE_LIMIT_ACTION=30/60
RATE_LIMIT_STREAM=30/60
RATE_LIMIT_RESET=3/60
# 0: X-Forwarded-For nəzərə alınmır. 1 (və ya N): server N etibarlı reverse proxy arxasındadır.
# Yalnız uvicorn birbaşa internetə açıq DEYİLSƏ aktiv edin, əks halda IP saxtalaşdırıla bilər.
TRUSTED_PROXY=0
# SSE (canlı axın): ümumi və bir IP üçün eyni anda açıq bağlantı sayı
MAX_SSE_SUBSCRIBERS=200
MAX_SSE_PER_IP=10

# ---------- AI xərc nəzarəti ----------
# Gündə (UTC) ən çox neçə model çağırışı (ehtiyat modellər də sayılır). 0: AI heç çağırılmır
AI_DAILY_LIMIT=300
# Uğursuz/fallback cavab bu qədər saniyə keşlənir, AI-ya dərhal təkrar sorğu getmir (0 söndürür)
AI_FAILURE_COOLDOWN_SEC=300

# ---------- İstehsal konfiqurasiyası ----------
# 1: /docs, /redoc və /openapi.json bağlanır
DISABLE_DOCS=0
# CSP, X-Content-Type-Options, Referrer-Policy, X-Frame-Options və s. (0 söndürür)
SECURITY_HEADERS=1
# Saytı iframe-də göstərməyə icazə verilən mənbələr (boş: 'none'), məs. https://nexusweb.az
CSP_FRAME_ANCESTORS=
# HSTS (saniyə). Yalnız HTTPS reverse proxy arxasında, məs. 31536000; 0 söndürür
HSTS_MAX_AGE=0
